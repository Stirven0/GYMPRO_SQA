{
  "info": {
    "name": "GymPro API Tests",
    "description": "Colección de pruebas de API para GymPro. Ejecutar: newman run gympro_api_tests.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login - Admin (éxito)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Rol administrador', () => {",
              "  pm.expect(pm.response.json().rol).to.eql('administrador');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "https://gestion-gympro.up.railway.app/api/auth/login",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@gympro.com\",\"password\":\"Admin1234!\"}"
        }
      }
    },
    {
      "name": "Login - Credenciales inválidas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Response has error', () => {",
              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "https://gestion-gympro.up.railway.app/api/auth/login",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"fake@email.com\",\"password\":\"wrongpass\"}"
        }
      }
    },
    {
      "name": "Login - Bypass CAPTCHA (sin resolver)",
